    <style>
      :root{--ink:#11162b;--muted:#626879;--paper:#f7f6f2;--card:#fff;--coral:#ff5c51;--lime:#c8f55c;--sky:#85d8ff;--line:#dfe0e5;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:radial-gradient(circle at 3% 0%,#ffe2dd,transparent 29rem),var(--paper);color:var(--ink)}a{color:inherit}:focus-visible{outline:3px solid var(--coral);outline-offset:4px}.skip{position:fixed;left:1rem;top:1rem;z-index:1000;transform:translateY(-180%);padding:.7rem 1rem;border-radius:999px;background:var(--ink);color:white;font-weight:850}.skip:focus{transform:none}
      .site-header{position:sticky;top:0;z-index:100;padding:.75rem 0;border-bottom:1px solid #11162b14;background:#f7f6f2e8;backdrop-filter:blur(18px)}.nav-shell{display:flex;align-items:center;gap:1.2rem;width:min(1180px,calc(100% - 2rem));margin:auto}.wordmark{display:flex;align-items:center;gap:.65rem;margin-right:auto;font-weight:900;text-decoration:none}.wordmark:before{content:"EG";display:grid;width:2.25rem;aspect-ratio:1;place-items:center;border-radius:.75rem;background:var(--coral);color:white;font-size:.7rem;box-shadow:0 8px 18px #ff5c5138}.wordmark span{color:var(--coral)}.desktop-nav,.account-nav{display:flex;align-items:center;gap:1.15rem}.desktop-nav a,.account-nav>a:first-child{font-size:.87rem;font-weight:750;text-decoration:none}.desktop-nav a:hover,.account-nav>a:first-child:hover{text-decoration:underline;text-underline-offset:.35rem}.signup{display:inline-flex;padding:.62rem .9rem;border-radius:.75rem;background:var(--ink);color:white;font-size:.84rem;font-weight:850;text-decoration:none}.mobile-nav{display:none}
      main{width:min(1180px,calc(100% - 2rem));margin:auto}.mast{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,6vw,6rem);align-items:center;padding:5.5rem 0 4.5rem}.edition{display:flex;gap:1rem;color:var(--coral);font-size:.7rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.mast h1{max-width:13ch;margin:1rem 0 1.3rem;font-size:clamp(3.2rem,6.7vw,6.3rem);line-height:.92;letter-spacing:-.07em}.mast h1 i{color:var(--coral);font-family:Georgia,"Times New Roman",serif;font-weight:500}.lede{max-width:39rem;color:var(--muted);font-size:clamp(1.05rem,1.8vw,1.28rem);line-height:1.6}.links{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.links a{padding:.78rem 1rem;border:1px solid var(--ink);border-radius:.8rem;font-size:.87rem;font-weight:850;text-decoration:none}.links a:first-child{background:var(--ink);color:white}.route{position:relative;overflow:hidden;padding:1.5rem;border:1px solid #11162b13;border-radius:1.7rem;background:var(--ink);color:white;box-shadow:0 36px 80px #11162b2b}.route:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 10%,#ff5c5145,transparent 45%),linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:auto,2rem 2rem,2rem 2rem}.route h2{position:relative;margin:0 0 1.5rem;color:var(--lime);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase}.stops{position:relative;margin:0;padding:0;list-style:none}.stops:before{content:"";position:absolute;left:4.5rem;top:.55rem;bottom:1rem;width:1px;background:#ffffff32}.stop{position:relative;display:grid;grid-template-columns:3.6rem 1rem 1fr;gap:.45rem;min-height:6.5rem}.time{color:#ffffff8c;font:750 .7rem ui-monospace,monospace}.dot{z-index:1;width:.72rem;height:.72rem;border:2px solid var(--ink);border-radius:50%;background:var(--lime);box-shadow:0 0 0 2px #ffffff36}.stop:nth-child(2) .dot{background:var(--coral)}.stop:nth-child(3) .dot{background:var(--sky)}.stop h3{margin:-.2rem 0 .25rem;font-size:1.05rem}.stop p{max-width:30ch;margin:0;color:#ffffff86;font-size:.78rem;line-height:1.45}
      .operations{display:grid;grid-template-columns:1.35fr .65fr;gap:1rem;padding:5rem 0}.manifest,.ticket{border-radius:1.5rem}.manifest{padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--line);background:var(--card)}.manifest h2{max-width:12ch;margin:0 0 2.5rem;font-size:clamp(2.3rem,4.8vw,4.7rem);line-height:.95;letter-spacing:-.06em}.manifest table{width:100%;border-collapse:collapse}.manifest th,.manifest td{padding:1rem .5rem;border-top:1px solid var(--line);text-align:left;vertical-align:top}.manifest th{width:24%;color:var(--coral);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase}.manifest td{color:var(--muted);font-size:.92rem;line-height:1.55}.ticket{display:flex;flex-direction:column;justify-content:space-between;min-height:34rem;padding:1.6rem;background:var(--lime);box-shadow:0 28px 60px #759b1d26}.ticket:before,.ticket:after{content:"";display:block;border-top:2px dashed #11162b55}.ticket small{font-size:.67rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.ticket strong{font-size:clamp(2.4rem,4.8vw,4.8rem);line-height:.88;letter-spacing:-.07em;text-transform:uppercase}.ticket .code{align-self:flex-end;font:750 .73rem ui-monospace,monospace;writing-mode:vertical-rl}
      .crosspost{margin-bottom:5rem;padding:clamp(2rem,5vw,4rem);border-radius:1.7rem;background:var(--coral);color:white}.crosspost h2{max-width:15ch;margin:0;font-size:clamp(2.2rem,4.7vw,4.5rem);line-height:.96;letter-spacing:-.06em}.crosspost .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-top:2rem}.crosspost article{min-height:12rem;padding:1.2rem;border:1px solid #ffffff35;border-radius:1rem;background:#ffffff10}.crosspost article>span{color:var(--lime);font-size:.7rem;font-weight:900}.crosspost article h3{margin:2rem 0 .5rem}.crosspost article p{margin:0;color:#ffffffbd;font-size:.88rem;line-height:1.55}
      .access{display:grid;grid-template-columns:.85fr 1.15fr;gap:3rem;align-items:start;padding:1rem 0 6rem}.access h2{max-width:13ch;margin:0;font-size:clamp(2.2rem,4.5vw,4.3rem);line-height:.98;letter-spacing:-.06em}.access-links{display:grid;gap:.7rem}.access-links a{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.1rem;border:1px solid var(--line);border-radius:.9rem;background:var(--card);text-decoration:none}.access-links small{color:var(--coral);font-weight:850;text-transform:uppercase}.access-links strong{font-size:.95rem}.site-footer{background:var(--ink);color:white}.footer-shell{display:grid;grid-template-columns:1.7fr repeat(2,1fr);gap:3rem;width:min(1180px,calc(100% - 2rem));margin:auto;padding:4rem 0}.footer-shell>div p{max-width:31rem;color:#ffffff8c;line-height:1.6}.footer-shell nav{display:grid;align-content:start;gap:.7rem}.footer-shell nav strong{margin-bottom:.3rem;color:var(--lime);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase}.footer-shell nav a{color:#ffffffa8;font-size:.88rem;text-decoration:none}.footer-base{display:flex;justify-content:space-between;width:min(1180px,calc(100% - 2rem));margin:auto;padding:1.2rem 0 2rem;border-top:1px solid #ffffff1d;color:#ffffff70;font-size:.77rem}
      @media(max-width:840px){.desktop-nav,.account-nav{display:none}.mobile-nav{display:block}.mobile-nav summary{padding:.55rem .8rem;border:1px solid #11162b22;border-radius:.75rem;font-weight:850;list-style:none}.mobile-nav[open] nav{position:absolute;top:calc(100% + .45rem);right:1rem;left:1rem;display:grid;gap:.3rem;padding:1rem;border-radius:1rem;background:var(--ink);color:white;box-shadow:0 28px 65px #11162b55}.mobile-nav nav a{padding:.75rem;text-decoration:none}.mast,.operations,.access{grid-template-columns:1fr}.mast h1{font-size:clamp(3.1rem,11vw,5.6rem)}.operations{padding-top:2rem}.ticket{min-height:24rem}.crosspost .cards{grid-template-columns:1fr 1fr}.footer-shell{grid-template-columns:1.5fr 1fr}.footer-shell nav:last-child{display:none}}
      @media(max-width:560px){.mast{padding-top:3.5rem}.mast h1{font-size:clamp(2.9rem,13vw,4.25rem)}.edition span:last-child{display:none}.route{padding:1.1rem}.manifest table,.manifest tbody,.manifest tr,.manifest th,.manifest td{display:block}.manifest tr{padding:.7rem 0;border-top:1px solid var(--line)}.manifest th,.manifest td{width:auto;padding:.25rem 0;border:0}.crosspost .cards{grid-template-columns:1fr}.footer-shell{grid-template-columns:1fr}.footer-base{flex-direction:column;gap:.4rem}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
